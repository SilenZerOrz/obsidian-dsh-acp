{
  "name": "obsidian-dsh-acp",
  "version": "0.1.3",
  "description": "Expose DeepSeek Harness (DSH) over the Agent Client Protocol (ACP) for Obsidian Agent Client (and other ACP clients). Install as a Custom Agent in Obsidian, or as a cordis plugin in a DSH profile, to drive DSH right from Obsidian — list/resume/fork sessions, run the harness, and archive conversations.",
  "author": {
    "name": "SilenZerOrz",
    "email": "SilenZerOrz@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilenZerOrz/obsidian-dsh-acp.git"
  },
  "homepage": "https://github.com/SilenZerOrz/obsidian-dsh-acp#readme",
  "bugs": {
    "url": "https://github.com/SilenZerOrz/obsidian-dsh-acp/issues"
  },
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./dsh-acp": "./dsh-acp.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-acp": "dsh-acp.mjs"
  },
  "files": [
    "index.mjs",
    "dsh-acp.mjs",
    "archive-store.mjs",
    "cordis.patch.yml",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node dsh-acp.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "acp",
    "agent-client-protocol",
    "obsidian",
    "agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  }
}
